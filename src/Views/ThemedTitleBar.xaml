<UserControl x:Class="ClaudeAccountSwitcher.ThemedTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="32">
    <Border Background="{StaticResource TitleBarBackgroundBrush}"
            BorderBrush="{StaticResource RowBorderBrush}" BorderThickness="0,0,0,1"
            CornerRadius="{Binding CornerRadius, ElementName=Root}"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource AppMutedForegroundBrush}"
                       VerticalAlignment="Center" Margin="10,0,0,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Content="&#x2013;" Click="MinimizeButton_Click" FontSize="14"
                        Width="32" Height="32" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed" />
                <Button x:Name="CloseButton" Content="&#x2715;" Click="CloseButton_Click" FontSize="11"
                        Width="32" Height="32" Style="{StaticResource IconButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
