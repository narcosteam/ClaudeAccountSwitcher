<Window x:Class="ClaudeAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeAccountSwitcher"
        xmlns:Shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Claude Account Switcher" Width="360" Height="440" MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Icon="/Resources/app.ico"
        Background="{StaticResource TitleBarBackgroundBrush}">
    <Shell:WindowChrome.WindowChrome>
        <Shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" />
    </Shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:ThemedTitleBar Grid.Row="0" Title="Claude Account Switcher" ShowMinimize="True" />

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <StackPanel x:Name="AccountsPanel" />
            </ScrollViewer>

            <Button x:Name="AddAccountButton" Grid.Row="1" Content="+ Add Account" Click="AddAccountButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />

            <TextBlock x:Name="VersionText" Grid.Row="2" FontSize="10" Margin="0,6,0,0"
                       HorizontalAlignment="Center" Foreground="{StaticResource AppMutedForegroundBrush}" />
        </Grid>

        <!-- ponytail: spans both rows (title bar included) so the whole
             window — not just the account list — is unusable while an
             update installs; a non-null Background already blocks
             click-through, no extra IsHitTestVisible wiring needed. -->
        <Border x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                Background="#CCF6F6F3">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="140" Height="4" Margin="0,0,0,10" />
                <TextBlock x:Name="BusyText" FontSize="11" Foreground="{StaticResource AppMutedForegroundBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
