<Window x:Class="ClaudeAccountSwitcher.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeAccountSwitcher"
        xmlns:Shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Add Claude Account" Width="352" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="True"
        Background="Transparent">
    <Shell:WindowChrome.WindowChrome>
        <Shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" />
    </Shell:WindowChrome.WindowChrome>
    <!-- Margin leaves room, inside the transparent window, for the drop shadow to fall off into —
         otherwise it'd get clipped at the window edge and the dialog would still blend into
         whatever's behind it (the owner window is the same background color). -->
    <Border Margin="16" Background="{StaticResource TitleBarBackgroundBrush}" BorderBrush="{StaticResource AppForegroundBrush}" BorderThickness="2" CornerRadius="8">
    <Border.Effect>
        <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="24" ShadowDepth="6" Direction="270" />
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:ThemedTitleBar Grid.Row="0" Title="Add Claude Account" CornerRadius="6,6,0,0" />

        <Grid Grid.Row="1" Margin="20">
            <StackPanel x:Name="IdlePanel" VerticalAlignment="Center">
                <TextBlock Text="ADD CLAUDE ACCOUNT" FontSize="11" Foreground="{StaticResource AppMutedForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,18" />
                <Button x:Name="SignInButton" Content="Sign in with Claude" Click="SignInButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>

            <StackPanel x:Name="WaitingPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="ADD CLAUDE ACCOUNT" FontSize="11" Foreground="{StaticResource AppMutedForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock Text="Waiting for sign-in..." FontSize="12" Foreground="{StaticResource AppForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Complete the login in your browser" FontSize="11" Foreground="{StaticResource AppMutedForegroundBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="270">
                <TextBlock x:Name="DoneNameText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="4,0" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock x:Name="DoneBadgeText" FontSize="9" Foreground="{StaticResource AppMutedForegroundBrush}" />
                </Border>
                <TextBlock x:Name="DoneStatusText" FontSize="11" Foreground="{StaticResource AppMutedForegroundBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="ADD CLAUDE ACCOUNT" FontSize="11" Foreground="{StaticResource AppMutedForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{StaticResource AppForegroundBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,14" />
                <Button x:Name="RetryButton" Content="Try again" Click="SignInButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
